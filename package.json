{
  "name": "college-discovery",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @collegehub/backend\" \"npm run dev -w @collegehub/frontend\"",
    "dev:backend": "npm run dev -w @collegehub/backend",
    "dev:frontend": "npm run dev -w @collegehub/frontend",
    "build": "npm run build -w @collegehub/backend && npm run build -w @collegehub/frontend",
    "build:backend": "npm run build -w @collegehub/backend",
    "build:frontend": "npm run build -w @collegehub/frontend",
    "lint": "npm run lint -w @collegehub/backend && npm run lint -w @collegehub/frontend",
    "db:generate": "npm run db:generate -w @collegehub/backend",
    "db:migrate": "npm run db:migrate -w @collegehub/backend",
    "db:migrate:status": "npm run db:migrate:status -w @collegehub/backend",
    "db:seed": "npm run db:seed -w @collegehub/backend",
    "db:studio": "npm run db:studio -w @collegehub/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
